{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dashboard",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "{migrations,database}/**" },
    "api/cron.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__path=$1" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 1 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
